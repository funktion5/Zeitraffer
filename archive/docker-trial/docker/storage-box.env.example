# Copy to docker/storage-box.env (gitignored) and fill in. Only needed with MOUNT_CAMERAS=1.
# Same values as /etc/timelapse/mount.env on the Pi.
REMOTE_USER=<user>
REMOTE_HOST=<host>
REMOTE_PORT=23
# Path inside the container: the SSH folder is copied to /home/app/.ssh at start.
REMOTE_SSH_KEY=/home/app/.ssh/<key-file>
