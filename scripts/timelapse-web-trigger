#!/bin/bash

set -euo pipefail

PROJECT_ROOT="${TIMELAPSE_PROJECT_ROOT:-/home/zruser/timelapse}"
LOCK_FILE="${TIMELAPSE_WEB_LOCK_FILE:-${PROJECT_ROOT}/state/zeitraffer-run.lock}"
CAMERA_ROOT="${TIMELAPSE_CAMERA_ROOT:-/mnt/cameras}"
STATUS_HELPER="${TIMELAPSE_WEB_STATUS_HELPER:-/usr/local/libexec/timelapse-web-status.sh}"
WORKER="${TIMELAPSE_WEB_WORKER:-/usr/local/libexec/timelapse-web-worker}"

if [[ $# -lt 4 || $# -gt 6 ]]; then
	echo "Usage: timelapse-web-trigger <job-id> <job> <target-date> <camera> [daylight-buffer-minutes | window-time window-tolerance-minutes]" >&2
	echo "daylight-buffer-minutes is required for daily/weekly; monthly/yearly take either nothing or a window time (HH:MM or sunset) plus tolerance." >&2
	exit 64
fi

JOB_ID="$1"
JOB="$2"
TARGET_DATE="$3"
CAMERA="$4"
DAYLIGHT_BUFFER_MINUTES="${5:-}"
WINDOW_TIME=""
WINDOW_TOLERANCE_MINUTES=""

# Monthly/Yearly reuse positions 5/6 for the optional interval window.
if [[ $# -eq 6 ]]; then
	DAYLIGHT_BUFFER_MINUTES=""
	WINDOW_TIME="$5"
	WINDOW_TOLERANCE_MINUTES="$6"
fi

if [[ ! -r "$STATUS_HELPER" || ! -x "$WORKER" ]]; then
	echo "Web job support files are unavailable." >&2
	exit 69
fi

# Load job-ID validation and atomic status writes.
source "$STATUS_HELPER"

if ! is_valid_job_id "$JOB_ID"; then
	echo "Invalid job ID." >&2
	exit 64
fi

case "$JOB" in
	daily|weekly|monthly|yearly)
		;;
	*)
		echo "Invalid job: $JOB" >&2
		exit 64
		;;
esac

if [[ ! "$TARGET_DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
	echo "Invalid date format: $TARGET_DATE" >&2
	exit 64
fi

NORMALIZED_DATE="$(date -d "$TARGET_DATE" "+%Y-%m-%d" 2>/dev/null || true)"

if [[ "$NORMALIZED_DATE" != "$TARGET_DATE" ]]; then
	echo "Invalid calendar date: $TARGET_DATE" >&2
	exit 64
fi

if [[ -z "$CAMERA" || "$CAMERA" == *"/"* || "$CAMERA" == "." || "$CAMERA" == ".." ]]; then
	echo "Invalid camera name." >&2
	exit 64
fi

if [[ ! -d "${CAMERA_ROOT}/${CAMERA}" ]]; then
	echo "Camera not found: $CAMERA" >&2
	exit 66
fi

case "$JOB" in
	daily|weekly)
		case "$DAYLIGHT_BUFFER_MINUTES" in
			30|60|90)
				;;
			*)
				echo "Invalid daylight buffer: $DAYLIGHT_BUFFER_MINUTES" >&2
				exit 64
				;;
		esac
		;;
	monthly|yearly)
		if [[ -n "$DAYLIGHT_BUFFER_MINUTES" ]]; then
			echo "Monthly/Yearly do not use a daylight buffer." >&2
			exit 64
		fi
		;;
esac

if [[ -n "$WINDOW_TIME" ]]; then
	case "$JOB" in
		monthly|yearly)
			;;
		*)
			echo "Daily/Weekly do not use an interval window." >&2
			exit 64
			;;
	esac

	# Format only; src.main rejects windows that would cross midnight.
	if [[ ! "$WINDOW_TIME" =~ ^(([01][0-9]|2[0-3]):[0-5][0-9]|sunset)$ ]]; then
		echo "Invalid window time: $WINDOW_TIME" >&2
		exit 64
	fi

	if [[ ! "$WINDOW_TOLERANCE_MINUTES" =~ ^[1-9][0-9]{0,2}$ ]]; then
		echo "Invalid window tolerance: $WINDOW_TOLERANCE_MINUTES" >&2
		exit 64
	fi
fi

COMMAND=(
	"$WORKER"
	"$JOB_ID"
	"$JOB"
	"$TARGET_DATE"
	"$CAMERA"
)

if [[ -n "$DAYLIGHT_BUFFER_MINUTES" ]]; then
	COMMAND+=("$DAYLIGHT_BUFFER_MINUTES")
fi

if [[ -n "$WINDOW_TIME" ]]; then
	COMMAND+=("$WINDOW_TIME" "$WINDOW_TOLERANCE_MINUTES")
fi

cd "$PROJECT_ROOT"

exec 9>"$LOCK_FILE"

if ! flock -n 9; then
	echo "Another timelapse job is already running." >&2
	exit 75
fi

write_job_status "$JOB_ID" "running"

nohup "${COMMAND[@]}" \
	</dev/null \
	>/dev/null \
	2>&1 &

JOB_PID="$!"

echo "Videoauftrag gestartet (PID ${JOB_PID})."
