#!/bin/bash

set -u

PROJECT_ROOT="${TIMELAPSE_PROJECT_ROOT:-/home/zruser/timelapse}"
PYTHON="${TIMELAPSE_WEB_PYTHON:-${PROJECT_ROOT}/.venv/bin/python3}"
STATUS_HELPER="${TIMELAPSE_WEB_STATUS_HELPER:-/usr/local/libexec/timelapse-web-status.sh}"

if [[ $# -lt 4 || $# -gt 6 ]]; then
	echo "Usage: timelapse-web-worker <job-id> <job> <target-date> <camera> [daylight-buffer-minutes | window-time window-tolerance-minutes]" >&2
	exit 64
fi

JOB_ID="$1"
JOB="$2"
TARGET_DATE="$3"
CAMERA="$4"
DAYLIGHT_BUFFER_MINUTES="${5:-}"
WINDOW_TIME=""
WINDOW_TOLERANCE_MINUTES=""

# Monthly/Yearly reuse positions 5/6 for the optional interval window.
if [[ $# -eq 6 ]]; then
	DAYLIGHT_BUFFER_MINUTES=""
	WINDOW_TIME="$5"
	WINDOW_TOLERANCE_MINUTES="$6"
fi

if [[ ! -r "$STATUS_HELPER" ]]; then
	echo "Status helper is unavailable." >&2
	exit 69
fi

# Load the validated atomic status-file operations.
source "$STATUS_HELPER"

if ! is_valid_job_id "$JOB_ID"; then
	echo "Invalid job ID." >&2
	exit 64
fi

case "$JOB" in
	daily|weekly|monthly|yearly)
		;;
	*)
		echo "Invalid job: $JOB" >&2
		exit 64
		;;
esac

case "$JOB" in
	daily|weekly)
		case "$DAYLIGHT_BUFFER_MINUTES" in
			30|60|90)
				;;
			*)
				echo "Invalid daylight buffer: $DAYLIGHT_BUFFER_MINUTES" >&2
				exit 64
				;;
		esac
		;;
	monthly|yearly)
		if [[ -n "$DAYLIGHT_BUFFER_MINUTES" ]]; then
			echo "Monthly/Yearly do not use a daylight buffer." >&2
			exit 64
		fi
		;;
esac

if [[ -n "$WINDOW_TIME" ]]; then
	case "$JOB" in
		monthly|yearly)
			;;
		*)
			echo "Daily/Weekly do not use an interval window." >&2
			exit 64
			;;
	esac

	# Format only; src.main rejects windows that would cross midnight.
	if [[ ! "$WINDOW_TIME" =~ ^(([01][0-9]|2[0-3]):[0-5][0-9]|sunset)$ ]]; then
		echo "Invalid window time: $WINDOW_TIME" >&2
		exit 64
	fi

	if [[ ! "$WINDOW_TOLERANCE_MINUTES" =~ ^[1-9][0-9]{0,2}$ ]]; then
		echo "Invalid window tolerance: $WINDOW_TOLERANCE_MINUTES" >&2
		exit 64
	fi
fi

# Record our own PID so job-status.php can detect a "running" status left
# behind by a worker that died without ever reaching write_job_status below
# (e.g. the Pi rebooted mid-job).
write_job_pid "$JOB_ID" "$$"

COMMAND=(
	"$PYTHON"
	-m
	src.main
	--jobs
	"$JOB"
	--target-date
	"$TARGET_DATE"
	--cameras
	"$CAMERA"
)

VIDEO_SUFFIX=""

if [[ -n "$DAYLIGHT_BUFFER_MINUTES" ]]; then
	COMMAND+=(--daylight-buffer-minutes "$DAYLIGHT_BUFFER_MINUTES")
	VIDEO_SUFFIX="_${DAYLIGHT_BUFFER_MINUTES}min"
fi

if [[ -n "$WINDOW_TIME" ]]; then
	COMMAND+=(--window-time "$WINDOW_TIME" --window-tolerance-minutes "$WINDOW_TOLERANCE_MINUTES")
	# IntervalWindow.label(): "18:30" -> "1830", "sunset" stays as is.
	VIDEO_SUFFIX="_${WINDOW_TIME/:/}-${WINDOW_TOLERANCE_MINUTES}min"
fi

# Must match src.video.get_video_path()'s manual-run filename exactly
# ({camera}_{date}.mp4, {camera}_{date}_{buffer}min.mp4 for daily/weekly, or
# {camera}_{date}_{HHMM|sunset}-{tolerance}min.mp4 for a monthly/yearly
# window), or this success/failure check below would never see the file the
# job actually publishes.
VIDEO_PATH="${PROJECT_ROOT}/videos/${CAMERA}/manual-runs/${JOB}/${CAMERA}_${TARGET_DATE}${VIDEO_SUFFIX}.mp4"
previous_video_signature=""

if [[ -f "$VIDEO_PATH" && ! -L "$VIDEO_PATH" ]]; then
	previous_video_signature="$(stat -Lc '%d:%i' "$VIDEO_PATH")"
fi

cd "$PROJECT_ROOT" || exit 69

if "${COMMAND[@]}"; then
	current_video_signature=""

	if [[ -f "$VIDEO_PATH" && ! -L "$VIDEO_PATH" ]]; then
		current_video_signature="$(stat -Lc '%d:%i' "$VIDEO_PATH")"
	fi

	if [[ -n "$current_video_signature" && "$current_video_signature" != "$previous_video_signature" ]]; then
		write_job_status "$JOB_ID" "completed"
		exit 0
	fi

	write_job_status "$JOB_ID" "failed" || true
	echo "The video job finished without publishing a new video." >&2
	exit 1
else
	exit_code="$?"
	write_job_status "$JOB_ID" "failed" || true
	exit "$exit_code"
fi
