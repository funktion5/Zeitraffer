#!/bin/bash

set -u

# Default: ~/timelapse of the account this runs as (sudo -u). Looked up via getent because
# sudo does not always reset HOME to the target user's home.
PROJECT_ROOT="${TIMELAPSE_PROJECT_ROOT:-$(getent passwd "$(id -un)" | cut -d: -f6)/timelapse}"
PYTHON="${TIMELAPSE_WEB_PYTHON:-${PROJECT_ROOT}/.venv/bin/python3}"
STATUS_HELPER="${TIMELAPSE_WEB_STATUS_HELPER:-/usr/local/libexec/timelapse-web-status.sh}"

if [[ $# -ne 4 && $# -ne 6 ]]; then
	echo "Usage: timelapse-web-worker <job-id> <job> <target-date> <camera> [window-time window-tolerance-minutes]" >&2
	exit 64
fi

JOB_ID="$1"
JOB="$2"
TARGET_DATE="$3"
CAMERA="$4"
WINDOW_TIME=""
WINDOW_TOLERANCE_MINUTES=""

# Positions 5 and 6 are the optional interval window of a Monthly/Yearly.
if [[ $# -eq 6 ]]; then
	WINDOW_TIME="$5"
	WINDOW_TOLERANCE_MINUTES="$6"
fi

if [[ ! -r "$STATUS_HELPER" ]]; then
	echo "Status helper is unavailable." >&2
	exit 69
fi

# Load the validated atomic status-file operations.
source "$STATUS_HELPER"

if ! is_valid_job_id "$JOB_ID"; then
	echo "Invalid job ID." >&2
	exit 64
fi

case "$JOB" in
	daily|weekly|monthly|yearly)
		;;
	*)
		echo "Invalid job: $JOB" >&2
		exit 64
		;;
esac

if [[ -n "$WINDOW_TIME" ]]; then
	case "$JOB" in
		monthly|yearly)
			;;
		*)
			echo "Daily/Weekly do not use an interval window." >&2
			exit 64
			;;
	esac

	# Format only; src.main rejects windows that would cross midnight.
	if [[ ! "$WINDOW_TIME" =~ ^(([01][0-9]|2[0-3]):[0-5][0-9]|sunset)$ ]]; then
		echo "Invalid window time: $WINDOW_TIME" >&2
		exit 64
	fi

	if [[ ! "$WINDOW_TOLERANCE_MINUTES" =~ ^[1-9][0-9]{0,2}$ ]]; then
		echo "Invalid window tolerance: $WINDOW_TOLERANCE_MINUTES" >&2
		exit 64
	fi
fi

# Record our own PID so job-status.php can detect a "running" status left
# behind by a worker that died without ever reaching write_job_status below
# (e.g. the host rebooted mid-job).
write_job_pid "$JOB_ID" "$$"

# This host has no mount and sudo clears the environment, so say where the frames come from. The
# alias is a Host entry in the ~/.ssh/config of the account this runs as; the key stays with that
# account, and the web server user never holds one.
export TIMELAPSE_FRAME_SOURCE=ssh
export TIMELAPSE_STORAGE_BOX="${TIMELAPSE_STORAGE_BOX:-storagebox}"

COMMAND=(
	"$PYTHON"
	-m
	src.main
	--jobs
	"$JOB"
	--target-date
	"$TARGET_DATE"
	--cameras
	"$CAMERA"
)

VIDEO_SUFFIX=""

# A manual Daily/Weekly uses the saved daylight buffer; src.main reads it itself. The worker only
# needs the value to name the video it waits for, so it asks the project's own config loader.
case "$JOB" in
	daily|weekly)
		if ! DAYLIGHT_BUFFER_MINUTES="$(cd "$PROJECT_ROOT" && "$PYTHON" -c 'from src.config import load_config; print(load_config()["daylight_buffer_minutes"])' 2>/dev/null)" \
			|| [[ ! "$DAYLIGHT_BUFFER_MINUTES" =~ ^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-3][0-9]|240)$ ]]; then
			echo "The daylight buffer setting could not be read." >&2
			write_job_status "$JOB_ID" "failed" || true
			exit 69
		fi

		VIDEO_SUFFIX="_${DAYLIGHT_BUFFER_MINUTES}min"
		;;
esac

if [[ -n "$WINDOW_TIME" ]]; then
	COMMAND+=(--window-time "$WINDOW_TIME" --window-tolerance-minutes "$WINDOW_TOLERANCE_MINUTES")
	# IntervalWindow.label(): "18:30" -> "1830", "sunset" stays as is.
	VIDEO_SUFFIX="_${WINDOW_TIME/:/}-${WINDOW_TOLERANCE_MINUTES}min"
fi

# Must match src.video.get_video_path()'s manual-run filename exactly
# ({camera}_{date}.mp4, {camera}_{date}_{buffer}min.mp4 for daily/weekly, or
# {camera}_{date}_{HHMM|sunset}-{tolerance}min.mp4 for a monthly/yearly
# window), or this success/failure check below would never see the file the
# job actually publishes.
VIDEO_PATH="${PROJECT_ROOT}/videos/${CAMERA}/manual-runs/${JOB}/${CAMERA}_${TARGET_DATE}${VIDEO_SUFFIX}.mp4"
previous_video_signature=""

if [[ -f "$VIDEO_PATH" && ! -L "$VIDEO_PATH" ]]; then
	previous_video_signature="$(stat -Lc '%d:%i' "$VIDEO_PATH")"
fi

cd "$PROJECT_ROOT" || exit 69

# src.main logs to stderr; keep it for this run so a failure can leave its cause behind.
# Without a temp file the job still runs, it just cannot name a failure reason.
output_file="$(mktemp)" || output_file=/dev/null
trap '[[ "$output_file" == /dev/null ]] || rm -f "$output_file"' EXIT

# The last "- skipping" warning says why no video came out (e.g. too few days); diagnostics
# logged after it (image range, unknown filenames) are not the cause. job-status.php
# translates the known ones and shows nothing for the rest. Written before "failed", so it is
# there when the browser sees the status.
write_failure_reason() {
	local reason_file="${STATUS_ROOT}/${JOB_ID}.reason"

	grep -F ' | WARNING | ' "$output_file" | grep -F ' - skipping ' | tail -n 1 \
		| sed 's/^.* | WARNING | //' \
		>"$reason_file" || true
	chmod 644 "$reason_file" 2>/dev/null || true
}

if "${COMMAND[@]}" 2>"$output_file"; then
	current_video_signature=""

	if [[ -f "$VIDEO_PATH" && ! -L "$VIDEO_PATH" ]]; then
		current_video_signature="$(stat -Lc '%d:%i' "$VIDEO_PATH")"
	fi

	if [[ -n "$current_video_signature" && "$current_video_signature" != "$previous_video_signature" ]]; then
		write_job_status "$JOB_ID" "completed"
		exit 0
	fi

	write_failure_reason
	write_job_status "$JOB_ID" "failed" || true
	echo "The video job finished without publishing a new video." >&2
	exit 1
else
	exit_code="$?"
	write_failure_reason
	write_job_status "$JOB_ID" "failed" || true
	exit "$exit_code"
fi
