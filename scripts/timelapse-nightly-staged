#!/bin/bash

# Nightly run on the VPS: writes the camera list for the web pages, runs the automatic pipeline
# once per camera, then verifies the result (exit code, job summaries, failed cameras, every new
# video). A failing camera never stops the others.
#
# Exit codes: 0 = everything ran and verified; 1 = the run or some cameras failed; 2 = fatal (the
# camera list could not be written, or is empty); 64 = bad setting; 70 = project folder unusable;
# 75 = another run holds the lock; 130 / 143 = stopped by Ctrl-C / SIGTERM. Nothing is sent
# anywhere; the report is a file.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="${TIMELAPSE_PROJECT_ROOT:-$(dirname "$SCRIPT_DIR")}"
PYTHON="${TIMELAPSE_NIGHTLY_PYTHON:-${PROJECT_ROOT}/.venv/bin/python3}"

cd "$PROJECT_ROOT" || exit 70

# A static ffmpeg and ffprobe in ~/bin, if present, win over the system ones.
export PATH="${HOME}/bin:${PATH}"
export TIMELAPSE_STORAGE_BOX="${TIMELAPSE_STORAGE_BOX:-storagebox}"
export TIMELAPSE_FRAME_SOURCE=ssh
# Default to a light preset so a host with little memory keeps FFmpeg small; the cron line sets it.
export TIMELAPSE_X264_PRESET="${TIMELAPSE_X264_PRESET:-ultrafast}"

case "$TIMELAPSE_X264_PRESET" in
	ultrafast|superfast|veryfast|faster|fast|medium|slow|slower|veryslow|placebo)
		;;
	*)
		echo "Invalid TIMELAPSE_X264_PRESET: $TIMELAPSE_X264_PRESET" >&2
		exit 64
		;;
esac

mkdir -p state logs/nightly || exit 70

# The same lock as cron and the web UI, held for the whole run.
exec 9>>"state/zeitraffer-run.lock"

if ! flock -n 9; then
	echo "Another timelapse run holds state/zeitraffer-run.lock." >&2
	exit 75
fi

RUN_ID="$(date +%Y%m%d-%H%M%S)"
RUN_DIR="logs/nightly/${RUN_ID}"
REPORT="${RUN_DIR}/report.txt"

mkdir -p "$RUN_DIR" || exit 70

note() {
	printf '%s\n' "$*" | tee -a "$REPORT"
}

# A stop signal sent to this script alone must reach the pipeline: bash would otherwise hold the
# signal until the whole run is over. The pipeline releases its frames on the way out, so it is
# waited for below.
STOPPED=0
MAIN_PID=""

stop_run() {
	STOPPED="$1"

	if [[ -n "$MAIN_PID" ]]; then
		kill -TERM "$MAIN_PID" 2>/dev/null
	fi
}

trap 'stop_run 130' INT
trap 'stop_run 143' TERM

# Check the videos this run wrote for one camera: none may be a hidden partial file or an empty or
# unreadable video. Sets CAMERA_PROBLEMS (empty when the camera is fine) and VERIFIED_VIDEOS.
verify_videos() {
	local camera="$1" marker="$2"
	local videos=0 file duration

	CAMERA_PROBLEMS=""

	if [[ -d "videos/${camera}" ]]; then
		while IFS= read -r file; do
			case "$(basename "$file")" in
				.*)
					CAMERA_PROBLEMS+="partial file left behind: ${file}; "
					continue
					;;
			esac

			videos=$((videos + 1))
			duration="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$file" 2>/dev/null </dev/null)"

			if [[ ! -s "$file" ]] || ! awk -v d="${duration:-0}" 'BEGIN { exit !(d + 0 > 0) }'; then
				CAMERA_PROBLEMS+="empty or unreadable video: ${file}; "
			fi
		done < <(find "videos/${camera}" -type f -name '*mp4' -newer "$marker")
	fi

	VERIFIED_VIDEOS="$videos"
}

# The exit code of src.main is not enough: a camera error is caught and only logged. So read the
# summary line of every job, and the lines that name a failed camera. Writes the failed cameras to
# failed-cameras.txt, one per line, and sets RUN_PROBLEMS (empty when the run is fine).
verify_run() {
	local main_rc="$1" main_out="$2"
	local finished=0 failed_total=0 named=0 line description failed skipped

	RUN_PROBLEMS=""

	if [[ "$main_rc" -ne 0 ]]; then
		RUN_PROBLEMS+="src.main exited with ${main_rc}; "
	fi

	while IFS= read -r line; do
		finished=$((finished + 1))
		description="$(sed -e 's/^.*| INFO | //' -e 's/ | created=.*$//' <<<"$line")"
		failed="$(sed -n 's/.*failed=\([0-9][0-9]*\).*/\1/p' <<<"$line")"
		skipped="$(sed -n 's/.*skipped=\([0-9][0-9]*\).*/\1/p' <<<"$line")"

		if [[ -z "$failed" ]]; then
			RUN_PROBLEMS+="${description}: failed=unreadable; "
		else
			failed_total=$((failed_total + failed))
		fi

		if [[ -n "$skipped" && "$skipped" -gt 0 ]]; then
			note "   skipped=${skipped}: ${description}"
		fi
	done < <(grep "timelapse job finished" "$main_out")

	if [[ "$finished" -ne 4 ]]; then
		RUN_PROBLEMS+="expected 4 job summary lines, found ${finished}; "
	fi

	# Each failed camera of a job is logged once with its name, a frame cache that could not be
	# removed too. The name is everything after "for camera: ".
	grep -E 'Failed to process .* for camera: |Could not remove fetched frames for camera: ' "$main_out" \
		| sed -e 's/^.*for camera: //' >"${RUN_DIR}/failed-cameras.txt"
	named="$(grep -c . "${RUN_DIR}/failed-cameras.txt")"

	if [[ "$failed_total" -gt "$named" ]]; then
		RUN_PROBLEMS+="the job summaries count ${failed_total} failures but the log names ${named} cameras; "
	fi
}

note "Nightly run ${RUN_ID} | preset=${TIMELAPSE_X264_PRESET} | box=${TIMELAPSE_STORAGE_BOX}"

# Writes state/web-jobs/cameras.json for the web pages and prints the cameras for this run. An
# old list would be stale, so a failure here ends the night.
if ! "$PYTHON" -m src.camera_list </dev/null >"${RUN_DIR}/cameras.txt" 2>"${RUN_DIR}/list-cameras.err"; then
	note "FATAL: could not write the camera list (see ${RUN_DIR}/list-cameras.err)"
	exit 2
fi

if [[ ! -s "${RUN_DIR}/cameras.txt" ]]; then
	note "FATAL: the storage box lists no cameras"
	exit 2
fi

if [[ "$STOPPED" -ne 0 ]]; then
	note "STOPPED before the run started"
	exit "$STOPPED"
fi

marker="${RUN_DIR}/.run-start"
main_out="${RUN_DIR}/main.out"
touch "$marker"

"$PYTHON" -m src.main </dev/null >"$main_out" 2>&1 &
MAIN_PID=$!

# A stop that arrived after the check above and before the pipeline had a pid.
if [[ "$STOPPED" -ne 0 ]]; then
	kill -TERM "$MAIN_PID" 2>/dev/null
fi

wait "$MAIN_PID"
main_rc=$?

# A stop signal ends the first wait early while the pipeline is still cleaning up: wait for it.
while kill -0 "$MAIN_PID" 2>/dev/null; do
	wait "$MAIN_PID"
	main_rc=$?
done

# Done: a later signal must not be sent to a pid that something else may have taken over.
MAIN_PID=""

if [[ "$STOPPED" -ne 0 ]]; then
	note "STOPPED by signal (exit ${STOPPED}): the run was cut short, src.main exited with ${main_rc}"
	exit "$STOPPED"
fi

verify_run "$main_rc" "$main_out"
run_failed=0

if [[ -n "$RUN_PROBLEMS" ]]; then
	note "FAILED (run): ${RUN_PROBLEMS}(see ${main_out})"
	run_failed=1
fi

total=0
failed_count=0
failed_list=""

# Read the list on fd 3: ffprobe inside the loop would otherwise swallow it from stdin.
while IFS= read -r camera <&3; do
	[[ -z "$camera" ]] && continue

	total=$((total + 1))
	note "== ${camera}"

	verify_videos "$camera" "$marker"

	if grep -Fxq -- "$camera" "${RUN_DIR}/failed-cameras.txt"; then
		CAMERA_PROBLEMS+="the log names it as failed; "
	fi

	if [[ -n "$CAMERA_PROBLEMS" ]]; then
		note "   FAILED: ${CAMERA_PROBLEMS}(see ${main_out})"
		failed_count=$((failed_count + 1))
		failed_list+="${camera}; "
	else
		note "   ok: ${VERIFIED_VIDEOS} videos verified"
	fi
done 3<"${RUN_DIR}/cameras.txt"

# The pipeline lists the cameras again on its own: one that appeared or vanished since the list above
# is not verified in the loop, but if it failed, the log names it and the night must not pass.
unlisted="$(sort -u "${RUN_DIR}/failed-cameras.txt" | grep -Fxvf "${RUN_DIR}/cameras.txt")"

if [[ -n "$unlisted" ]]; then
	note "FAILED (run): failed but not in this run's camera list: ${unlisted//$'\n'/, }"
	run_failed=1
fi

note "Cameras: ${total}, failed: ${failed_count}"

if [[ "$failed_count" -gt 0 ]]; then
	note "Failed: ${failed_list}"
fi

# A stop during the verification must not end as a pass or an ordinary failure.
if [[ "$STOPPED" -ne 0 ]]; then
	note "STOPPED by signal (exit ${STOPPED}) during the verification: the result above may be incomplete"
	exit "$STOPPED"
fi

if [[ "$failed_count" -gt 0 || "$run_failed" -ne 0 ]]; then
	exit 1
fi

exit 0
