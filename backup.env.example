# Settings of backup.sh. Copy this file to backup.env (git-ignored) and fill in BACKUP_HOST, or pass
# the values as environment variables instead. One NAME=value per line, without quotes.

# The ssh alias of the host in ~/.ssh/config (required):
BACKUP_HOST=

# Project folder on the host, relative to its home (default: timelapse):
#PROJECT_DIR=timelapse

# Where the backup goes (default: ~/timelapse-backup). Write the full path, without ~:
#DEST=

# 1 also saves videos/: several GB, and the nightly run builds new ones (default: 0):
#VIDEOS=0
