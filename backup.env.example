# Copy to backup.env (gitignored) on your own computer and fill in. No quotes needed.
# BACKUP_HOST: the host's name (e.g. myhost.local) or its IP address.
BACKUP_HOST=myhost.local
BACKUP_USER=myuser
# Optional. Project folder on the host; ~ and $HOME mean the home folder ON THE HOST.
# Default: ~/timelapse
PROJECT_DIR=
# Optional. Default: ~/timelapse-backup — keep it out of iCloud-synced folders, and inside WSL
# out of the Windows drives (/mnt/c, ...).
DEST=
