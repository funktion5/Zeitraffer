# Login of the nightly video upload (scripts/copy_zeitraffer_videos_vps2siteground.sh).
# Copy this file to config/siteground.env and fill in the three values; ./install.sh does the copy.
# The real file is git-ignored and must never be committed. One NAME=value per line, without
# quotes or escaping: everything after the first equals sign is the value.
SITEGROUND_HOST=
SITEGROUND_USER=
SITEGROUND_PASS=
